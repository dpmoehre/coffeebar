{
  "mcpServers": {
    "coffeebar": {
      "type": "stdio",
      "command": "coffeebar-mcp",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "COFFEEBAR_URL": "http://127.0.0.1:8000",
        "PATH": "${workspaceFolder}${/}.venv${/}bin${pathSeparator}${workspaceFolder}${/}.venv${/}Scripts${pathSeparator}${env:PATH}"
      }
    }
  }
}
